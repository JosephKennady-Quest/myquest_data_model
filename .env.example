# ══════════════════════════════════════════════════════════════════════════════
#  AEL V2 Pipeline — Environment Variables
#  Copy this file to .env and fill in the values.
#  .env is gitignored — never commit it.
# ══════════════════════════════════════════════════════════════════════════════


# ── Source DB (quest_rearch_production) ───────────────────────────────────────

# Set to true only if this machine already has direct network access to
# SOURCE_RDS_HOST (e.g. it runs inside the same VPC as the DB). Skips the SSH
# tunnel entirely. Leave false/unset when running from outside that network —
# the SOURCE_SSH_* variables below are required in that case.
SOURCE_DIRECT_CONNECT=false

# Bastion / jump server (not used when SOURCE_DIRECT_CONNECT=true)
SOURCE_SSH_HOST=ip_address
SOURCE_SSH_PORT=22
SOURCE_SSH_USER=username
# Filename only — file must exist in ael_v2_pipeline/DB_Config/
SOURCE_SSH_PKEY_FILE=key.pem

# RDS endpoint — accessed through the tunnel, or directly if SOURCE_DIRECT_CONNECT=true
SOURCE_RDS_HOST=host_source
SOURCE_RDS_PORT=port_number

# MySQL credentials
SOURCE_DB_USER=username
SOURCE_DB_PASSWORD=password
SOURCE_DB_NAME=database_name


# ── Destination DB (myquest_data_model) ───────────────────────────────────────

# Same idea as SOURCE_DIRECT_CONNECT above, for the destination DB.
DEST_DIRECT_CONNECT=false

# Bastion / jump server (not used when DEST_DIRECT_CONNECT=true)
DEST_SSH_HOST=ip_address
DEST_SSH_PORT=22
DEST_SSH_USER=username
# Filename only — file must exist in ael_v2_pipeline/DB_Config/
DEST_SSH_PKEY_FILE=key.pem

# RDS endpoint — accessed through the tunnel, or directly if DEST_DIRECT_CONNECT=true
DEST_RDS_HOST=destination_host
DEST_RDS_PORT=port_number

# MySQL credentials
DEST_DB_USER=username
DEST_DB_PASSWORD=password
DEST_DB_NAME=database_name


# ── Output ────────────────────────────────────────────────────────────────────
OUTPUT_DIR=output
QUERIES_DIR=queries

# ── Chunking ──────────────────────────────────────────────────────────────────
# Source rows fetched per chunk and destination rows inserted per executemany call.
QUERY_FETCH_CHUNK_SIZE=5000
DB_WRITE_CHUNK_SIZE=5000
