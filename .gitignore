.claude/

# ── Pipeline incremental state ─────────────────────────────────
# Auto-generated by main.py. Tracks last successful run timestamp
# per table so incremental runs know what has changed since the
# previous execution. Machine-local — do not commit.
.pipeline_state.json

# ── Dev notes ──────────────────────────────────────────────────
# Personal scratch notes, investigation logs, or local planning
# docs. Keep these in DEV_NOTES.md or a docs/dev/ folder and
# git-ignore them so they never land in the shared repo.
DEV_NOTES.md
docs/dev/
